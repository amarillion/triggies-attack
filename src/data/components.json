{
	"components": {

		"constant": {
			"name": "Constant output dial",
			"shortName": "Dial",
			"hint": "Click on the dial to change the output. Outputs whole numbers between 0 and 6, as well as fractions 1/2 and 1/4.",
			"size": { "x": 4, "y": 3 },
			"tileIdx": 3,
			"ports": {
				"U": {
					"delta": { "x": 0, "y": 2 },
					"type" : "out",
					"calc" : "v"
				}
			}
		},

		"simple_clock": {
			"name": "Clock signal",
			"hint": "Generates a clock signal. Starts at 0 and increases to 1.0, then starts over again. Usually the starting point of a circuit.",
			"shortName": "Clock",
			"size": { "x": 2, "y": 3 },
			"tileIdx": 7,
			"ports": {
				"T": {
					"delta": { "x": 0, "y": 2 },
					"type" : "out",
					"calc" : "frac(t)"
				}
			}
		},

		"output_xy": {
			"name": "Laser Coordinate Output",
			"hint": "Moves the x and y coordinates of the laser. This should be the output of your circuit.",
			"shortName": "Laser",
			"size": { "x": 2, "y": 2 },
			"tileIdx": 9,
			"ports": {
				"X": {
					"delta": { "x": 0, "y": 0 },
					"type" : "in",
					"global": true
				},
				"Y": {
					"delta": { "x": 0, "y": 1 },
					"type" : "in",
					"global": true
				}
			}
		},

		"output_rxy": {
			"name": "Laser Coordinate Output (Red)",
			"hint": "Moves the x and y coordinates of the RED laser. This should be the output of your circuit.",
			"shortName": "Red laser",
			"size": { "x": 2, "y": 2 },
			"tileIdx": 13,
			"ports": {
				"RX": {
					"delta": { "x": 0, "y": 0 },
					"type" : "in",
					"global": true
				},
				"RY": {
					"delta": { "x": 0, "y": 1 },
					"type" : "in",
					"global": true
				}
			}
		},

		"output_bxy": {
			"name": "Laser Coordinate Output (Blue)",
			"hint": "Moves the x and y coordinates of the BLUE laser. This should be the output of your circuit.",
			"shortName": "Blue laser",
			"size": { "x": 2, "y": 2 },
			"tileIdx": 11,
			"ports": {
				"BX": {
					"delta": { "x": 0, "y": 0 },
					"type" : "in",
					"global": true
				},
				"BY": {
					"delta": { "x": 0, "y": 1 },
					"type" : "in",
					"global": true
				}
			}
		},

		"output_gxy": {
			"name": "Laser Coordinate Output (Green)",
			"hint": "Moves the x and y coordinates of the GREEN laser. This should be the output of your circuit.",
			"shortName": "Green laser",
			"size": { "x": 2, "y": 2 },
			"tileIdx": 15,
			"ports": {
				"GX": {
					"delta": { "x": 0, "y": 0 },
					"type" : "in",
					"global": true
				},
				"GY": {
					"delta": { "x": 0, "y": 1 },
					"type" : "in",
					"global": true
				}
			}
		},

		"add": {
			"name": "Addition",
			"hint": "Adds two inputs together.",
			"shortName": "+",
			"size": { "x": 4, "y": 2 },
			"tileIdx": 224,
			"ports": {
				"A": {
					"delta": { "x": 0, "y": 0 },
					"type" : "in"
				},
				"B": {
					"delta": { "x": 0, "y": 1 },
					"type" : "in"
				},
				"U": {
					"delta": { "x": 3, "y": 1 },
					"type": "out",
					"calc": "A + B"
				}
			}
		},

		"sub": {
			"name": "Subtraction",
			"hint": "Substracts the bottom input from the top input.",
			"shortName": "-",
			"size": { "x": 4, "y": 2 },
			"tileIdx": 160,
			"ports": {
				"A": {
					"delta": { "x": 0, "y": 0 },
					"type" : "in"
				},
				"B": {
					"delta": { "x": 0, "y": 1 },
					"type" : "in"
				},
				"U": {
					"delta": { "x": 3, "y": 1 },
					"type": "out",
					"calc": "A - B"
				}
			}
		},

		"mul": {
			"name": "Multiplication",
			"hint": "Multiplies two inputs.",
			"shortName": "✕",
			"size": { "x": 4, "y": 2 },
			"tileIdx": 96,
			"ports": {
				"A": {
					"delta": { "x": 0, "y": 0 },
					"type" : "in"
				},
				"B": {
					"delta": { "x": 0, "y": 1 },
					"type" : "in"
				},
				"U": {
					"delta": { "x": 3, "y": 1 },
					"type": "out",
					"calc": "A * B"
				}
			}
		},

		"div": {
			"name": "Division",
			"hint": "Divides the top input by the bottom input.",
			"shortName": "÷",
			"size": { "x": 4, "y": 2 },
			"tileIdx": 105,
			"ports": {
				"A": {
					"delta": { "x": 0, "y": 0 },
					"type" : "in"
				},
				"B": {
					"delta": { "x": 0, "y": 1 },
					"type" : "in"
				},
				"U": {
					"delta": { "x": 3, "y": 1 },
					"type": "out",
					"calc": "A / B"
				}
			}
		},

		"inc": {
			"name": "Increment by 1",
			"hint": "Adds exactly 1 to the input.",
			"shortName": "inc",
			"size": { "x": 4, "y": 1 },
			"tileIdx": 260,
			"ports": {
				"A": {
					"delta": { "x": 0, "y": 0 },
					"type" : "in"
				},
				"U": {
					"delta": { "x": 3, "y": 0 },
					"type": "out",
					"calc": "A + 1"
				}
			}
		},

		"dec": {
			"name": "Decrement by 1",
			"hint": "Substract 1 from the input.",
			"shortName": "dec",
			"size": { "x": 4, "y": 1 },
			"tileIdx": 228,
			"ports": {
				"A": {
					"delta": { "x": 0, "y": 0 },
					"type" : "in"
				},
				"U": {
					"delta": { "x": 3, "y": 0 },
					"type": "out",
					"calc": "A - 1"
				}
			}
		},


		"abs": {
			"name": "Absolute Value",
			"hint": "Takes the absolute value of the input. This means that for negative inputs, the sign is removed, making them positive.",
			"shortName": "Abs",
			"size": { "x": 4, "y": 1 },
			"tileIdx": 264,
			"ports": {
				"A": {
					"delta": { "x": 0, "y": 0 },
					"type" : "in"
				},
				"U": {
					"delta": { "x": 3, "y": 0 },
					"type": "out",
					"calc": "abs(A)"
				}
			}
		},

		"neg": {
			"name": "Negate Value",
			"hint": "Makes positive inputs negative, and vice versa.",
			"shortName": "Neg",
			"size": { "x": 4, "y": 1 },
			"tileIdx": 268,
			"ports": {
				"A": {
					"delta": { "x": 0, "y": 0 },
					"type" : "in"
				},
				"U": {
					"delta": { "x": 3, "y": 0 },
					"type": "out",
					"calc": "0 - A"
				}
			}
		},

		"sign": {
			"name": "Sign Function",
			"hint": "Ouputs 1, -1, depending on whether the input is netagive.",
			"shortName": "Sign",
			"size": { "x": 4, "y": 1 },
			"tileIdx": 272,
			"ports": {
				"A": {
					"delta": { "x": 0, "y": 0 },
					"type" : "in"
				},
				"U": {
					"delta": { "x": 3, "y": 0 },
					"type": "out",
					"calc": "sign(A)"
				}
			}
		},

		"sincos": {
			"name": "Sine and Cosine",
			"hint": "Outputs both sine and cosine. An input of 1.0 corresponds to a full circle, i.e. the input is multiplied by 2π.",
			"shortName": "Sin & Cos",
			"size": { "x": 5, "y": 4 },
			"tileIdx": 100,
			"ports": {
				"A": {
					"delta": { "x": 0, "y": 0 },
					"type" : "in"
				},
				"U": {
					"delta": { "x": 4, "y": 1 },
					"type" : "out",
					"calc": "cos(A * 6.28318)"
				},
				"V": {
					"delta": { "x": 2, "y": 3 },
					"type": "out",
					"calc": "sin(A * 6.28318)"
				}
			}
		},

		"cos": {
			"name": "Cosine function",
			"hint": "Outputs a cosine wave. An input of 1.0 corresponds to a full circle, i.e. the input is multiplied by 2π.",
			"shortName": "Cos",
			"size": { "x": 4, "y": 2 },
			"tileIdx": 109,
			"ports": {
				"A": {
					"delta": { "x": 0, "y": 0 },
					"type" : "in"
				},
				"U": {
					"delta": { "x": 3, "y": 1 },
					"type" : "out",
					"calc": "cos(A * 6.28318)"
				}
			}
		},

		"sin": {
			"name": "Sine function",
			"hint": "Outputs a sine wave. An input of 1.0 corresponds to a full circle, i.e. the input is multiplied by 2π.",
			"shortName": "Sin",
			"size": { "x": 3, "y": 3 },
			"tileIdx": 113,
			"ports": {
				"A": {
					"delta": { "x": 0, "y": 0 },
					"type" : "in"
				},
				"U": {
					"delta": { "x": 2, "y": 2 },
					"type" : "out",
					"calc": "sin(A * 6.28318)"
				}
			}
		},

		"monitor": {
			"name": "Monitor an output value",
			"hint": "Connect this to any intermediate output to see its value. Useful for debugging and checking your work.",
			"shortName": "Monitor",
			"size": { "x": 2, "y": 3 },
			"tileIdx": 169,
			"ports": {
				"A": {
					"delta": { "x": 0, "y": 2 },
					"type" : "in"
				}
			}
		},

		"int_frac": {
			"name": "Split integer and fraction",
			"hint": "Splits the input in two, the parts before and after the decimal separator.",
			"shortName": "Int & Frac",
			"size": { "x": 3, "y": 3 },
			"tileIdx": 288,
			"ports": {
				"A": {
					"delta": { "x": 1, "y": 0 },
					"type" : "in"
				},
				"U": {
					"delta": { "x": 0, "y": 2 },
					"type": "out",
					"calc": "floor(A)"
				},
				"V": {
					"delta": { "x": 2, "y": 2 },
					"type": "out",
					"calc": "frac(A)"
				}
			}
		},

		"lerp": {
			"name": "Linear Interpolation",
			"shortName": "Interpolate",
			"hint": "Interpolates the middle input between left and right. The middle input range is between 1 and 0. The left and right inputs correspond to the output range.",
			"size": { "x": 3, "y": 3 },
			"tileIdx": 291,
			"ports": {
				"L": {
					"delta": { "x": 0, "y": 0 },
					"type" : "in"
				},
				"A": {
					"delta": { "x": 1, "y": 0 },
					"type" : "in"
				},
				"H": {
					"delta": { "x": 2, "y": 0 },
					"type" : "in"
				},
				"V": {
					"delta": { "x": 1, "y": 2 },
					"type": "out",
					"calc": "L + (H - L) * A"
				}
			}
		}

	}
}